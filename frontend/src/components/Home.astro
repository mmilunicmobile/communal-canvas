---
import MatrixCanvas from "./custom/MatrixCanvas.astro";
import { GRID_WIDTH, GRID_HEIGHT } from '../scripts/constants'
import PageSwitcher from './custom/PageSwitcher.tsx';
import ColorSwitcher from './custom/ColorSwitcher.tsx';
---

<script>
    import { main } from '../scripts/main'
    main()
</script>

<div class="flex h-svh flex-col overflow-hidden bg-background text-foreground">
    <div class="flex justify-center pt-4">
        <PageSwitcher client:load />
    </div>

    <div data-page-panel="paint" class="flex flex-1 min-h-0 flex-col overflow-hidden">
        <div class="flex flex-1 items-center justify-center px-0 py-4 sm:px-4">
            <MatrixCanvas canvasWidth={GRID_WIDTH} canvasHeight={GRID_HEIGHT} />
        </div>

        <div id="paint-color-switcher" class="flex justify-center pb-4">
            <ColorSwitcher client:load />
        </div>
    </div>

    <div data-page-panel="images" style="display: none;" class="flex flex-1 min-h-0 flex-col overflow-hidden px-4 py-4">
        <div class="flex min-h-0 flex-1 flex-col gap-4 overflow-hidden">
            <div class="flex items-end justify-between gap-3">
                <div>
                    <p class="text-sm font-medium">Gallery</p>
                    <p class="text-xs text-muted-foreground">Click a tile to display it. Drag files here to upload.</p>
                </div>
                <p id="gallery-status" class="text-xs text-muted-foreground"></p>
            </div>

            <div
                id="gallery-drop-zone"
                class="flex min-h-0 flex-1 flex-col overflow-hidden rounded-none border border-dashed border-border/60 bg-card/40 p-3 transition-all"
            >
                <div
                    id="gallery-grid"
                    class="grid min-h-0 flex-1 auto-rows-min gap-3 overflow-auto pr-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"
                ></div>
            </div>
        </div>

        <div class="mt-4 flex shrink-0 items-center justify-center gap-2 pb-0">
            <button id="gallery-add-button" type="button" class="border border-border bg-accent px-3 py-2 text-xs font-medium text-foreground transition hover:border-foreground/40">
                Add image
            </button>
            <button id="gallery-delete-mode-button" type="button" class="border border-border bg-accent px-3 py-2 text-xs font-medium text-foreground transition hover:border-foreground/40">
                Delete mode: off
            </button>
        </div>

        <input id="gallery-file-input" type="file" accept="image/*" class="hidden" />
    </div>

    <div data-page-panel="commands" style="display: none;" class="flex flex-1 min-h-0 flex-col overflow-auto px-4 py-4">
        <div class="mx-auto flex w-full max-w-3xl flex-col gap-6">
            <div class="flex items-end justify-between gap-3">
                <div>
                    <p class="text-sm font-medium">Commands</p>
                    <p class="text-xs text-muted-foreground">Adjust display controls and passkey requirements.</p>
                </div>
                <p id="commands-status" class="text-xs text-muted-foreground"></p>
            </div>

            <section class="flex flex-col gap-3 border border-border bg-card p-4">
                <div class="flex items-center justify-between gap-3">
                    <label for="commands-brightness" class="text-xs font-medium">Brightness</label>
                    <span id="commands-brightness-value" class="text-xs text-muted-foreground">20%</span>
                </div>
                <input
                    id="commands-brightness"
                    type="range"
                    min="0"
                    max="100"
                    value="20"
                    class="w-full accent-primary"
                />
            </section>

            <section class="flex flex-col gap-3 border border-border bg-card p-4">
                <div>
                    <p class="text-xs font-medium">Permission Requirements</p>
                    <p class="text-[11px] text-muted-foreground">On means that feature requires the admin passkey.</p>
                </div>
                <div id="commands-permissions" class="grid gap-2 sm:grid-cols-2"></div>
            </section>

            <section class="flex flex-col gap-3 border border-border bg-card p-4">
                <label for="commands-input" class="text-xs font-medium">Command Line</label>
                <form id="commands-form" class="flex gap-2">
                    <input
                        id="commands-input"
                        type="text"
                        autocomplete="off"
                        placeholder="rainbow"
                        class="min-w-0 flex-1 border border-border bg-background px-3 py-2 text-xs text-foreground placeholder-muted-foreground transition focus:outline-none focus:ring-1 focus:ring-primary"
                    />
                    <button type="submit" class="border border-border bg-accent px-3 py-2 text-xs font-medium text-foreground transition hover:border-foreground/40">
                        Send
                    </button>
                </form>
                <p id="commands-output" class="min-h-4 text-xs text-muted-foreground"></p>
            </section>
        </div>
    </div>

    <div data-page-panel="settings" style="display: none;" class="flex flex-1 min-h-0 flex-col overflow-auto px-4 py-4">
        <div class="mx-auto flex w-full max-w-3xl flex-col gap-6">
            <div>
                <p class="text-sm font-medium">Settings</p>
                <p class="text-xs text-muted-foreground">Configure connection and authentication.</p>
            </div>

            <div class="flex flex-col gap-4">
                <div class="flex flex-col gap-2">
                    <label for="settings-backend-url" class="text-xs font-medium">Backend URL</label>
                    <input
                        id="settings-backend-url"
                        type="text"
                        placeholder="(connects to current origin by default)"
                        class="border border-border bg-card px-3 py-2 text-xs text-foreground placeholder-muted-foreground transition focus:outline-none focus:ring-1 focus:ring-primary"
                    />
                    <p class="text-[11px] text-muted-foreground">Enter any backend value to try. Leave empty to use the current origin.</p>
                </div>

                <div class="flex flex-col gap-2">
                    <label for="settings-passkey" class="text-xs font-medium">Admin Passkey</label>
                    <input
                        id="settings-passkey"
                        type="password"
                        placeholder="changeme"
                        class="border border-border bg-card px-3 py-2 text-xs text-foreground placeholder-muted-foreground transition focus:outline-none focus:ring-1 focus:ring-primary"
                    />
                    <p class="text-[11px] text-muted-foreground">Used for any feature that currently requires the passkey.</p>
                </div>

                <div class="flex gap-2">
                    <button id="settings-reset-button" type="button" class="border border-border bg-accent px-3 py-2 text-xs font-medium text-foreground transition hover:border-foreground/40">
                        Reset to defaults
                    </button>
                </div>

                <div class="flex flex-col gap-3 border border-border bg-card p-4">
                    <div>
                        <p class="text-xs font-medium">Access Status</p>
                        <p class="text-[11px] text-muted-foreground">Shows what the current passkey and anonymous visitors can do.</p>
                    </div>
                    <div id="settings-access-status" class="grid gap-2 sm:grid-cols-2"></div>
                </div>
            </div>
        </div>

        <input id="settings-file-input" type="file" accept="image/*" class="hidden" />
    </div>
</div>
