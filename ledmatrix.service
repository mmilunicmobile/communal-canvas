[Unit]
Description=LED Matrix Backend
After=network.target

[Service]
User=root
WorkingDirectory=/home/pi/ledmatrix/backend
EnvironmentFile=/home/pi/ledmatrix/.env
ExecStart=/usr/bin/python3 -m uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
